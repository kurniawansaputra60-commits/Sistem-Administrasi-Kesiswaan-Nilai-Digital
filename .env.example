# ========================================================
# PANDUAN ENVIRONMENT VARIABLES (GITHUB / VERCEL / TIDB CLOUD)
# ========================================================

# 1. Konfigurasi Database TiDB Cloud Serverless (Rekomendasi Utama)
# Dapatkan dari TiDB Cloud Console -> Connect -> General Connection Parameters
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_prefix.root
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=db_kesiswaan_sekolah
TIDB_ENABLE_SSL=true

# ATAU gunakan single DATABASE_URL (format connection string TiDB / Prisma / Vercel)
# DATABASE_URL=mysql://your_prefix.root:your_tidb_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/db_kesiswaan_sekolah?ssl={"rejectUnauthorized":true}

# 2. Konfigurasi MySQL Standar / cPanel / Hosting Pribadi (Opsional)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=db_kesiswaan_sekolah
MYSQL_ENABLE_SSL=false

# 3. Mode Server
NODE_ENV=production
PORT=3000