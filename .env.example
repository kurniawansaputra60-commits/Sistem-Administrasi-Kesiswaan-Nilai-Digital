# Konfigurasi Database TiDB Cloud / MySQL
# Port default TiDB Cloud adalah 4000 (MySQL standar 3306)
TIDB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_prefix.root
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=db_kesiswaan_sekolah
TIDB_ENABLE_SSL=true

# Alias konfigurasi MySQL standar (opsional)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=